<UserControl
    x:Class="WorkLifeBalance.Features.CloseApp.CloseWarningView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:closeApp="clr-namespace:WorkLifeBalance.Features.CloseApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=closeApp:CloseWarningViewModel}"
    mc:Ignorable="d">

    <DockPanel>
        <Button
            HorizontalAlignment="Right"
            Command="{Binding CloseAppCommand}"
            Content="Yes, close app"
            DockPanel.Dock="Bottom"
            Style="{StaticResource ToolbarButtonDanger}" />
        <TextBlock
            VerticalAlignment="Center"
            Style="{StaticResource BodyText}"
            Text="Are you sure you want to close the app?" />
    </DockPanel>
</UserControl>
