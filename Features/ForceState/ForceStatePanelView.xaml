<UserControl
    x:Class="WorkLifeBalance.Features.ForceState.ForceStatePanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:forceState="clr-namespace:WorkLifeBalance.Features.ForceState"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=forceState:ForceStatePanelViewModel}"
    mc:Ignorable="d">

    <DockPanel>
        <TextBlock
            DockPanel.Dock="Top"
            Style="{StaticResource PanelHeaderText}"
            Text="FORCE STATE" />
        <TextBlock
            Margin="0,6,0,0"
            DockPanel.Dock="Bottom"
            Style="{StaticResource CaptionText}"
            Text="Click to change"
            TextAlignment="Center" />

        <!--  Cycles Working, Resting and Idle  -->
        <Button
            Margin="0,10,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Command="{Binding ChangeForcedStateCommand}"
            Cursor="Hand"
            FocusVisualStyle="{x:Null}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <StackPanel>
                        <Grid Width="56" Height="56">
                            <Ellipse x:Name="Disc" Fill="{Binding ForcedAppState, Converter={StaticResource AppStateToBrushConverter}}" />
                            <Path
                                Width="24"
                                Height="24"
                                Data="{Binding ForcedAppState, Converter={StaticResource AppStateToIconConverter}}"
                                Fill="White"
                                Stretch="Uniform" />
                        </Grid>
                        <TextBlock
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            FontSize="{StaticResource FontSize.Md}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Text="{Binding ForcedAppState}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Disc" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </DockPanel>
</UserControl>
