<UserControl
    x:Class="WorkLifeBalance.Features.Statistics.StatisticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:statistics="clr-namespace:WorkLifeBalance.Features.Statistics"
    d:DataContext="{d:DesignInstance Type=statistics:StatisticsViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="Stat" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="StatDate" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily.Numbers}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>

        <Style
            x:Key="CardHeader"
            BasedOn="{StaticResource SectionHeaderText}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="10" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="3" Style="{StaticResource InsetCard}">
            <DockPanel>
                <Grid Margin="0,0,0,10" DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource CardHeader}" Text="Personal record" />
                    <Button
                        HorizontalAlignment="Right"
                        Command="{Binding SeeAllDaysCommand}"
                        Content="All days"
                        Style="{StaticResource ToolbarButton}" />
                </Grid>
                <UniformGrid VerticalAlignment="Top" Columns="2">
                    <StackPanel ToolTip="The day you worked the most, and the work amount">
                        <TextBlock Style="{StaticResource StatLabel}" Text="MOST WORKED" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding RecordMostWorked, Converter={StaticResource TimeOnlyToStringConverter}}" />
                        <TextBlock Style="{StaticResource StatDate}" Text="{Binding RecordMostWorkedDate, Converter={StaticResource DateOnlyToStringConverter}}" />
                    </StackPanel>
                    <StackPanel ToolTip="The day you rested the most, and the rest amount">
                        <TextBlock Style="{StaticResource StatLabel}" Text="MOST RESTED" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding RecordMostRested, Converter={StaticResource TimeOnlyToStringConverter}}" />
                        <TextBlock Style="{StaticResource StatDate}" Text="{Binding RecordMostRestedDate, Converter={StaticResource DateOnlyToStringConverter}}" />
                    </StackPanel>
                </UniformGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource InsetCard}">
            <DockPanel>
                <Grid Margin="0,0,0,10" DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource CardHeader}" Text="Previous month" />
                    <Button
                        HorizontalAlignment="Right"
                        Command="{Binding SeePreviousMonthCommand}"
                        Content="Days"
                        Style="{StaticResource ToolbarButton}" />
                </Grid>
                <UniformGrid VerticalAlignment="Top" Columns="2">
                    <StackPanel Style="{StaticResource Stat}" ToolTip="Previous Month Work Ratio, the average amount of work divided by 24 hours">
                        <TextBlock Style="{StaticResource StatLabel}" Text="WORK RATIO" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding PreviousMonthWorkRestRatio}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Stat}" ToolTip="Total recorded days in the previous month">
                        <TextBlock Style="{StaticResource StatLabel}" Text="RECORDED DAYS" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding PreviousMonthTotalDays}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Stat}" ToolTip="The averate amount of work last month">
                        <TextBlock Style="{StaticResource StatLabel}" Text="AVERAGE WORKED" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding PreviousMonthAverageWorked, Converter={StaticResource TimeOnlyToStringConverter}}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Stat}" ToolTip="The day you worked the most in the last month, and the work amount">
                        <TextBlock Style="{StaticResource StatLabel}" Text="MOST WORKED" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding PreviousMonthMostWorked, Converter={StaticResource TimeOnlyToStringConverter}}" />
                        <TextBlock Style="{StaticResource StatDate}" Text="{Binding PreviousMonthMostWorkedDate, Converter={StaticResource DateOnlyToStringConverter}}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Stat}" ToolTip="The day you rested the most in the last month, and the rest amount">
                        <TextBlock Style="{StaticResource StatLabel}" Text="MOST RESTED" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding PreviousMonthMostRested, Converter={StaticResource TimeOnlyToStringConverter}}" />
                        <TextBlock Style="{StaticResource StatDate}" Text="{Binding PreviousMonthMostRestedDate, Converter={StaticResource DateOnlyToStringConverter}}" />
                    </StackPanel>
                </UniformGrid>
            </DockPanel>
        </Border>

        <Border
            Grid.Row="2"
            Grid.Column="2"
            Style="{StaticResource InsetCard}">
            <DockPanel>
                <Grid Margin="0,0,0,10" DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource CardHeader}" Text="Current month" />
                    <Button
                        HorizontalAlignment="Right"
                        Command="{Binding SeeCurrentMonthCommand}"
                        Content="Days"
                        Style="{StaticResource ToolbarButton}" />
                </Grid>
                <UniformGrid VerticalAlignment="Top" Columns="2">
                    <StackPanel Style="{StaticResource Stat}" ToolTip="Current Month Work Ratio, the average amount of work divided by 24 hours">
                        <TextBlock Style="{StaticResource StatLabel}" Text="WORK RATIO" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding CurrentMonthWorkRestRatio}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Stat}" ToolTip="Total recorded days in the current month">
                        <TextBlock Style="{StaticResource StatLabel}" Text="RECORDED DAYS" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding CurrentMonthTotalDays}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Stat}" ToolTip="The averate amount of work in the current month">
                        <TextBlock Style="{StaticResource StatLabel}" Text="AVERAGE WORKED" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding CurrentMonthAverageWorked, Converter={StaticResource TimeOnlyToStringConverter}}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Stat}" ToolTip="The day you worked the most in the current month, and the work amount">
                        <TextBlock Style="{StaticResource StatLabel}" Text="MOST WORKED" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding CurrentMonthMostWorked, Converter={StaticResource TimeOnlyToStringConverter}}" />
                        <TextBlock Style="{StaticResource StatDate}" Text="{Binding CurrentMonthMostWorkedDate, Converter={StaticResource DateOnlyToStringConverter}}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Stat}" ToolTip="The day you rested the most in the current month, and the rest amount">
                        <TextBlock Style="{StaticResource StatLabel}" Text="MOST RESTED" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding CurrentMonthMostRested, Converter={StaticResource TimeOnlyToStringConverter}}" />
                        <TextBlock Style="{StaticResource StatDate}" Text="{Binding CurrentMonthMostRestedDate, Converter={StaticResource DateOnlyToStringConverter}}" />
                    </StackPanel>
                </UniformGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
