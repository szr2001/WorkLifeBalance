<UserControl
    x:Class="WorkLifeBalance.Features.Statistics.DaysView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="clr-namespace:WorkLifeBalance.Shared.Controls"
    xmlns:icons="clr-namespace:WorkLifeBalance.Shared.Icons"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:statistics="clr-namespace:WorkLifeBalance.Features.Statistics"
    d:DataContext="{d:DesignInstance Type=statistics:DaysViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="FilterLabel"
            BasedOn="{StaticResource CaptionText}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <StackPanel
            Margin="0,0,0,8"
            DockPanel.Dock="Top"
            Orientation="Horizontal">
            <TextBlock Style="{StaticResource FilterLabel}" Text="Month" />
            <controls:PickerField
                Width="80"
                Margin="0,0,12,0"
                Columns="4"
                Options="{Binding MonthOptions}"
                SelectedValue="{Binding SelectedMonth}" />
            <TextBlock Style="{StaticResource FilterLabel}" Text="Day" />
            <controls:PickerField
                Width="70"
                Margin="0,0,12,0"
                Columns="7"
                Options="{Binding DayOptions}"
                SelectedValue="{Binding SelectedDay}" />
            <TextBlock Style="{StaticResource FilterLabel}" Text="Year" />
            <controls:PickerField
                Width="80"
                Columns="3"
                Options="{Binding YearOptions}"
                SelectedValue="{Binding SelectedYear}" />
        </StackPanel>

        <Border Padding="8,4" Style="{StaticResource InsetCard}">
            <DataGrid ItemsSource="{Binding LoadedData}" Style="{StaticResource Table}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding DateC, StringFormat=MM/dd/yyyy}"
                        ElementStyle="{StaticResource NumberCell}"
                        Header="Date" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding WorkedAmmountC, StringFormat=HH:mm:ss}"
                        ElementStyle="{StaticResource NumberCell}"
                        Header="Worked" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding RestedAmmountC, StringFormat=HH:mm:ss}"
                        ElementStyle="{StaticResource NumberCell}"
                        Header="Rested" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding IdleAmmountC, StringFormat=HH:mm:ss}"
                        ElementStyle="{StaticResource NumberCell}"
                        Header="Idle" />
                    <DataGridTemplateColumn Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Command="{Binding DataContext.ViewDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Height="20"
                                    Style="{StaticResource IconButton}"
                                    Tag="{icons:Phosphor InfoBold}"
                                    ToolTip="Day details" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
