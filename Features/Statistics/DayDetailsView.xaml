<UserControl
    x:Class="WorkLifeBalance.Features.Statistics.DayDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:statistics="clr-namespace:WorkLifeBalance.Features.Statistics"
    d:DataContext="{d:DesignInstance Type=statistics:DayDetailsViewModel}"
    mc:Ignorable="d">

    <DockPanel>
        <Border
            Margin="0,0,0,10"
            DockPanel.Dock="Top"
            Style="{StaticResource InsetCard}">
            <UniformGrid Columns="3">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="WORKED" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding LoadedDayData.WorkedAmmountC, Converter={StaticResource TimeOnlyToStringConverter}}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="RESTED" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding LoadedDayData.RestedAmmountC, Converter={StaticResource TimeOnlyToStringConverter}}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="IDLE" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding LoadedDayData.IdleAmmountC, Converter={StaticResource TimeOnlyToStringConverter}}" />
                </StackPanel>
            </UniformGrid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="10" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Padding="8,4" Style="{StaticResource InsetCard}">
                <DataGrid ItemsSource="{Binding ProcessActivities}" Style="{StaticResource Table}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Process}"
                            ElementStyle="{StaticResource TextCell}"
                            Header="Process" />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding TimeSpentC, StringFormat=HH:mm:ss}"
                            ElementStyle="{StaticResource NumberCell}"
                            Header="Time" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border
                Grid.Column="2"
                Padding="8,4"
                Style="{StaticResource InsetCard}">
                <DataGrid ItemsSource="{Binding PageActivities}" Style="{StaticResource Table}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Url}"
                            ElementStyle="{StaticResource TextCell}"
                            Header="Page" />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding TimeSpentC, StringFormat=HH:mm:ss}"
                            ElementStyle="{StaticResource NumberCell}"
                            Header="Time" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
