<UserControl
    x:Class="WorkLifeBalance.Features.Updates.UpdateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:updates="clr-namespace:WorkLifeBalance.Features.Updates"
    d:DataContext="{d:DesignInstance Type=updates:UpdateViewModel}"
    mc:Ignorable="d">

    <DockPanel>
        <TextBlock
            Margin="0,0,0,8"
            DockPanel.Dock="Top"
            Style="{StaticResource SectionHeaderText}"
            Text="{Binding Version}" />
        <Button
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Command="{Binding GoToDownloadCommand}"
            Content="Download"
            DockPanel.Dock="Bottom"
            Style="{StaticResource ToolbarButtonPrimary}" />
        <Border Style="{StaticResource InsetCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding UpdateLog}" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
