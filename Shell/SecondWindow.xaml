<Window
    x:Class="WorkLifeBalance.Shell.SecondWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:WorkLifeBalance.Shared.Icons"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:WorkLifeBalance.Shell"
    Title="WorkLifeBalance"
    Width="740"
    Height="580"
    d:DataContext="{d:DesignInstance Type=shell:SecondWindowViewModel}"
    AllowsTransparency="True"
    Background="Transparent"
    PreviewMouseDown="OnPreviewMouseDown"
    ResizeMode="NoResize"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.InputBindings>
        <KeyBinding
            Key="Left"
            Command="{Binding GoBackCommand}"
            Modifiers="Alt" />
    </Window.InputBindings>

    <!--
        The window has the size of the biggest page and the card animates to the size of each page (SecondWindow.xaml.cs).
        The margin leaves room for the shadow, the window cuts anything outside it. Clicks go through the empty part.
    -->
    <Grid
        x:Name="Card"
        Width="320"
        Height="320"
        Margin="16"
        HorizontalAlignment="Left"
        VerticalAlignment="Top">
        <Border Style="{StaticResource CardShadow}" />
        <Border Padding="0" Style="{StaticResource SurfaceCard}">
            <DockPanel>
                <Border
                    Padding="8"
                    Background="Transparent"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    DockPanel.Dock="Top"
                    MouseDown="MoveWindow">
                    <DockPanel>
                        <Button
                            Margin="0,0,6,0"
                            Command="{Binding GoBackCommand}"
                            DockPanel.Dock="Left"
                            Style="{StaticResource IconButton}"
                            Tag="{icons:Phosphor ArrowLeftBold}"
                            ToolTip="Back (Alt+Left)"
                            Visibility="{Binding Navigation.CanGoBack, Converter={StaticResource BoolToVisibleConverter}}" />
                        <Button
                            Command="{Binding CloseWindowCommand}"
                            DockPanel.Dock="Right"
                            Style="{StaticResource IconButtonDanger}"
                            Tag="{icons:Phosphor XBold}"
                            ToolTip="Close" />
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SectionHeaderText}"
                            Text="{Binding WindowService.LoadedPage.PageName}" />
                    </DockPanel>
                </Border>
                <ContentControl Margin="14,12,14,14" Content="{Binding WindowService.LoadedPage}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
